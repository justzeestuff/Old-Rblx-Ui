{
  "manifest_version": 2,
  "name": "TimeTurner",
  "version": "0.0.1",
  "description": "This turns ur Modern Roblox UI to 2017 styled UI",
  "permissions": [
    "https://www.roblox.com/*",
    "https://*.roblox.com/*"
    ],
  "web_accessible_resources": [
    "dist/components/stdHeader/stdHeader.module.css",
    
    "index.css",
    "assets/img/RobloxLogo.png"
  ],   
  "content_scripts": [
    {
      "matches": ["https://www.roblox.com/*"],
      "js": [
        "dist/components/stdHeader/stdHeader.js",

        "dist/util/AttributeRemover.js",
        "dist/util/user.js",
        
        "dist/main.js"
      ],
      "css": ["index.css"],
      "run_at": "document_end"
    }
  ]
}
