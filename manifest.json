{
  "manifest_version": 2,
  "name": "TimeTurner",
  "version": "0.0.1",
  "description": "This turns ur Modern Roblox UI to 2017 styled UI",
  "permissions": [
    "https://www.roblox.com/*",
    "https://*.roblox.com/*"
    ],
  "web_accessible_resources": [
    "index.css",
    "assets/img/RobloxLogo.png"
  ],   
  "content_scripts": [
    {
      "matches": ["https://www.roblox.com/*"],
      "js": [
        "assets/Util/AttributeRemover.js",
        
        "assets/components/stdHeader.js",
        "assets/components/profileHeadshot.js",
  
        "assets/pages/home/MainEl.js",
        "assets/pages/home/Profile.js",
        
        "main.js"
      ],
      "css": ["index.css"],
      "run_at": "document_end"
    }
  ]
}
